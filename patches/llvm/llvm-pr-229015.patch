+; RUN: opt -aa-pipeline=basic-aa -passes=attributor-cgscc -attributor-manifest-internal -S < %s | FileCheck %s --check-prefixes=CHECK,CGSCC
+
+; The value a recursive call returns must not be replaced by an instruction of
+; the caller: the callee returns its own instance of that instruction.
+
+define internal i64 @walk(i64 %d, i64 %a) {
+; CHECK: Function Attrs: nofree nosync nounwind memory(none)
+; CHECK-LABEL: define {{[^@]+}}@walk
+; CHECK-SAME: (i64 [[D:%.*]], i64 [[A:%.*]]) #[[ATTR0:[0-9]+]] {
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[ISZERO:%.*]] = icmp eq i64 [[D]], 0
+; CHECK-NEXT:    br i1 [[ISZERO]], label [[RETURN:%.*]], label [[RECURSE:%.*]]
+; CHECK:       recurse:
+; CHECK-NEXT:    [[D1:%.*]] = add i64 [[D]], -1
+; CHECK-NEXT:    [[A1:%.*]] = add i64 [[A]], 1
+; CHECK-NEXT:    [[R:%.*]] = call i64 @walk(i64 [[D1]], i64 [[A1]]) #[[ATTR0]]
+; CHECK-NEXT:    br label [[RETURN]]
+; CHECK:       return:
+; CHECK-NEXT:    [[RESULT:%.*]] = phi i64 [ [[R]], [[RECURSE]] ], [ [[A]], [[ENTRY:%.*]] ]
+; CHECK-NEXT:    ret i64 [[RESULT]]
+;
+entry:
+  %iszero = icmp eq i64 %d, 0
+  br i1 %iszero, label %return, label %recurse
+
+recurse:
+  %d1 = add i64 %d, -1
+  %a1 = add i64 %a, 1
+  %r = call i64 @walk(i64 %d1, i64 %a1)
+  br label %return
+
+return:
+  %result = phi i64 [ %r, %recurse ], [ %a, %entry ]
+  ret i64 %result
+}
